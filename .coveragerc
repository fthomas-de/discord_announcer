[run]
branch = True
# the package this repo ships; "example" stood here and measured nothing
source = discord_announcer
omit =
    discord_announcer/migrations/*
    discord_announcer/tests/*

[report]
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
